{
  "name": "@react-compiler-marker/cli",
  "version": "1.0.0",
  "description": "CLI tool to check React Compiler optimization status",
  "type": "module",
  "main": "./out/index.js",
  "bin": {
    "rcm": "./bin/cli.js"
  },
  "files": ["out", "bin"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blazejkustra/react-compiler-marker-cli.git"
  },
  "homepage": "https://github.com/blazejkustra/react-compiler-marker-cli#readme",
  "bugs": {
    "url": "https://github.com/blazejkustra/react-compiler-marker-cli/issues"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/parser": "^7.26.2",
    "babel-plugin-react-compiler": "1.0.0",
    "globby": "^14.0.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "20.x",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@babel/helpers": ">=7.26.10"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "compiler",
    "cli",
    "optimization"
  ],
  "license": "MIT",
  "author": "Blazej Kustra <kustrablazej@gmail.com>"
}
